{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "teslak",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html"
    ]
  }
}
